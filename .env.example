# Application Settings
APP_NAME="Brightloop Subscription Management System"
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./brightloop.db
# Docker PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/brightloop

# Security & JWT Tokens
SECRET_KEY=brightloop-secret-key-phase1-production-ready-jwt-token-signing
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# URLs
FRONTEND_URL=http://localhost:5173

# Email Configuration (Console logging active in development)
EMAIL_CONSOLE_LOG=True
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@brightloop.io

